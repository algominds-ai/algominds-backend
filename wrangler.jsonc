{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "algo-backend",
	"main": "src/index.ts",
	"account_id": "558c97456d4a969cb82bee23d2054613",
	"compatibility_date": "2026-08-27",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },

	// Neither package can run on Workers; both arrive transitively.
	// See docs/plans/…-plan.md KTD4. Do not remove.
	"alias": {
		"undici": "./build/stub-undici.ts",
		"cross-spawn": "./build/stub-cross-spawn.ts"
	},

	// Two configs against ONE database. `direct` has caching disabled and is
	// used for dedupe reads, because Hyperdrive does not invalidate on write.
	// Create with:
	//   wrangler hyperdrive create algo-cached --connection-string="postgres://…"
	//   wrangler hyperdrive create algo-direct  --connection-string="postgres://…" --caching-disabled
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE_CACHED",
			"id": "<algo-cached-id>",
			"localConnectionString": "postgresql://postgres:postgres@localhost:5432/algo"
		},
		{
			"binding": "HYPERDRIVE_DIRECT",
			"id": "<algo-direct-id>",
			"localConnectionString": "postgresql://postgres:postgres@localhost:5432/algo"
		}
	],

	"workflows": [
		{
			"binding": "FIND_COMPANIES",
			"name": "find-companies",
			"class_name": "FindCompaniesWorkflow"
		},
		{
			"binding": "FIND_PEOPLE",
			"name": "find-people",
			"class_name": "FindPeopleWorkflow",
			"limits": { "steps": 25000 }
		},
		{ "binding": "ENRICH", "name": "enrich", "class_name": "EnrichWorkflow" },
		{
			"binding": "ONBOARD_ICP",
			"name": "onboard-icp",
			"class_name": "OnboardIcpWorkflow"
		}
	],

	// Non-secret configuration. Real values live in .env for local dev.
	"vars": {
		"CF_ACCOUNT_ID": "558c97456d4a969cb82bee23d2054613",
		"CF_GATEWAY_ID": "",
		"AI_GATEWAY_BASE_URL": "",
		"MODEL_ROUTE_REASONING": "",
		"MODEL_ROUTE_WORKER": ""
	},

	// Production secrets. Local dev reads the same names from .env only; do not create .dev.vars, it shadows .env and breaks model calls.
	// Create with: wrangler secrets-store secret create <store> --name <NAME> --scopes workers
	"secrets_store_secrets": [
		{
			"binding": "EXA_API_KEY",
			"store_id": "5ad6bd7de0494762a21914ec40d3e4da",
			"secret_name": "exa-api-key"
		},
		{
			"binding": "FINDYMAIL_API_KEY",
			"store_id": "5ad6bd7de0494762a21914ec40d3e4da",
			"secret_name": "findymail-api-key"
		},
		{
			"binding": "CF_AIG_TOKEN",
			"store_id": "5ad6bd7de0494762a21914ec40d3e4da",
			"secret_name": "cf-aig-token"
		},
		{
			"binding": "CLAY_API_KEY",
			"store_id": "5ad6bd7de0494762a21914ec40d3e4da",
			"secret_name": "clay-api-key"
		}
	]
}
