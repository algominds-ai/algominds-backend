{
	"name": "algo-backend",
	"private": true,
	"type": "module",
	"author": "Lahfir",
	"scripts": {
		"dev": "SFW_SHIM_DISABLE=1 wrangler dev",
		"deploy": "SFW_SHIM_DISABLE=1 wrangler deploy",
		"build": "SFW_SHIM_DISABLE=1 wrangler deploy --dry-run --outdir=dist",
		"typecheck": "tsc --noEmit",
		"lint": "biome check . && bun scripts/check-comments.mjs && bun scripts/check-language.mjs && bun scripts/check-step-config.mjs",
		"lint:fix": "biome check --write . && bun scripts/check-comments.mjs && bun scripts/check-language.mjs && bun scripts/check-step-config.mjs",
		"test": "SFW_SHIM_DISABLE=1 vitest run",
		"test:watch": "vitest",
		"config": "bun scripts/config-gen.mjs",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"cf-typegen": "SFW_SHIM_DISABLE=1 wrangler types",
		"gate": "SFW_SHIM_DISABLE=1 bun scripts/gate.mjs"
	},
	"dependencies": {
		"@ai-sdk/mcp": "2.0.39",
		"@ai-sdk/openai-compatible": "3.0.39",
		"ai": "7.0.83",
		"drizzle-orm": "0.45.2",
		"hono": "4.13.5",
		"postgres": "3.4.9",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@cloudflare/vitest-plugin": "1.1.1",
		"@cloudflare/workers-types": "5.20260827.1",
		"@types/node": "26.4.0",
		"drizzle-kit": "0.31.10",
		"typescript": "7.0.2",
		"vitest": "4.1.11",
		"wrangler": "4.127.0"
	}
}
