{
  "source_type": "people",
  "fields": [
    {
      "name": "about_keywords",
      "type": "string[]",
      "description": "Search for one or more comma-separated keywords in the profile about section"
    },
    {
      "name": "certification_keywords",
      "type": "string[]",
      "description": "Search for one or more comma-separated keywords in the profile's certifications"
    },
    {
      "name": "company_annual_revenues",
      "type": "string[]",
      "description": "Search for one or more annual revenue ranges. E.g $1M - $5M",
      "allowed_values": [
        "0-500K",
        "500K-1M",
        "1M-5M",
        "5M-10M",
        "10M-25M",
        "25M-75M",
        "75M-200M",
        "200M-500M",
        "500M-1B",
        "1B-10B",
        "10B-100B",
        "100B-1T"
      ]
    },
    {
      "name": "company_description_keywords",
      "type": "string[]",
      "description": "Search for one or more comma-separated keywords in the company's description. E.g 'trusted, experts'"
    },
    {
      "name": "company_description_keywords_exclude",
      "type": "string[]",
      "description": "Exclude one or more comma-separated keywords in the company's description. E.g 'remote, beginners'"
    },
    {
      "name": "company_identifier",
      "type": "string[]",
      "description": "Company LinkedIn URL, Company Domain, Sales Navigator URL, or Sales Navigator Company ID. Use this field when: (1) the user explicitly provides a URL or domain, OR (2) you know the company's domain as established public knowledge from your training data and have high confidence (e.g., \"Google\" → \"google.com\", \"McKinsey & Company\" → \"mckinsey.com\", \"OpenAI\" → \"openai.com\"). The name does not need to literally match the domain. If the domain is uncertain or not part of your established knowledge, use company_description_keywords instead. NEVER fabricate or infer a LinkedIn URL from a company name."
    },
    {
      "name": "company_industries_exclude",
      "type": "string[]",
      "description": "Exclude one or more industries"
    },
