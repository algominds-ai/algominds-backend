  "guidance": {
    "behavior": [
      "Each top-level filter narrows the result set (AND).",
      "Multiple values in one string[] filter broaden matches (OR).",
      "Omit fields instead of passing empty arrays; empty arrays do not restrict results.",
      "Email addresses, phone numbers, Fortune 500, unicorn status, and employer lookalikes are not native public API filters."
    ],
    "field_guidance": [
      {
        "id": "employer_identifier",
        "text": "company_identifier requires a company LinkedIn URL, domain, Sales Navigator URL, or Sales Navigator company ID. Resolve employer names to domains only when the mapping is high confidence; otherwise use company_industries_include or ask for a domain. Never fabricate a LinkedIn URL.",
        "fields": [
          "company_identifier"
        ]
      },
      {
        "id": "employer_keywords_scope",
        "text": "Use company_description_keywords for topical employer description text, not company names, domains, LinkedIn URLs, Sales Navigator identifiers, employer sizes, or industries.",
        "fields": [
          "company_identifier",
          "company_description_keywords"
        ]
      },
      {
        "id": "employer_similarity",
        "text": "For people at companies similar to an example, infer the closest company_industries_include values instead of using company_identifier for the example company.",
        "fields": [
          "company_identifier",
          "company_industries_include"
        ]
      },
      {
        "id": "employer_groups",
        "text": "For well-known current-employer groups, expand to member domains when confidence is high: Big 4 = deloitte.com, pwc.com, ey.com, kpmg.com; MBB = mckinsey.com, bcg.com, bain.com; FAANG = meta.com, amazon.com, apple.com, netflix.com, google.com.",
        "fields": [
          "company_identifier"
        ]
      },
      {
        "id": "past_experience_flag",
        "text": "Phrases like former, past, ex-, previously at, alumni, or ever worked at require include_past_experiences set to true. Otherwise searches default to current roles.",
        "fields": [
          "include_past_experiences"
        ]
      },
      {
        "id": "seniority",
        "text": "Omit seniority when the request does not state a level. Use leadership values only for executive asks. For minimum experience such as \"4+ years\" or \"senior+\", use job_title_seniority_match_mode = floor with job_title_seniority_floor_level.",
        "fields": [
          "job_title_seniority_levels_v2",
          "job_title_keywords"
        ]
      },
      {
        "id": "seniority_floor",
        "text": "For \"4+ years of experience\", \"experienced\", or \"at least N years\", use floor mode with an appropriate floor level instead of enumerating exact seniority values.",
        "fields": [
          "job_title_seniority_match_mode",
          "job_title_seniority_floor_level",
          "job_title_seniority_levels_v2"
        ]
      },
      {
        "id": "role_tenure_and_dates",
        "text": "Recent hires use current_role_max_months_since_start_date; tenured roles use current_role_min_months_since_start_date; explicit role start/end windows use role_range_start_month and role_range_end_month in YYYY-MM format.",
        "fields": [
          "current_role_max_months_since_start_date",
