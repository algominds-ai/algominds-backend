{
	"$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
	"plugins": [
		"./lint/anti-slop/no-chained-type-assertions.grit",
		"./lint/anti-slop/no-module-mocking.grit",
		"./lint/anti-slop/no-unknown-type-aliases.grit",
		"./lint/rules/no-type-assertions.grit",
		"./lint/rules/no-loose-record.grit"
	],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!docs",
			"!.claude/settings.local.json",
			"!.claude/worktrees"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noBannedTypes": "error",
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": {
						"maxAllowedComplexity": 10
					}
				},
				"noExcessiveLinesPerFunction": {
					"level": "error",
					"options": {
						"maxLines": 80,
						"skipBlankLines": true
					}
				},
				"useMaxParams": {
					"level": "error",
					"options": {
						"max": 4
					}
				}
			},
			"suspicious": {
				"noExplicitAny": "error"
			},
			"style": {
				"noNonNullAssertion": "error",
				"noExcessiveLinesPerFile": {
					"level": "error",
					"options": {
						"maxLines": 400,
						"skipBlankLines": true
					}
				},
				"noRestrictedTypes": {
					"level": "error",
					"options": {
						"types": {
							"object": {
								"message": "`object` is an untyped bag. Declare the real shape."
							},
							"Object": {
								"message": "Use a declared interface or a Zod-inferred type."
							},
							"Function": {
								"message": "Declare the call signature you actually need."
							}
						}
					}
				},
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["./*", "../*"],
								"message": "Use @/* imports \u2014 relative paths are forbidden."
							}
						]
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"worker-configuration.d.ts",
				"drizzle/**",
				"src/core/db/auth-schema.ts"
			],
			"formatter": {
				"enabled": false
			},
			"linter": {
				"enabled": false
			},
			"assist": {
				"enabled": false
			}
		},
		{
			"includes": ["test/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off",
						"noExcessiveLinesPerFile": "off"
					}
				}
			}
		}
	]
}
